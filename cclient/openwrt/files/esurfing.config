config esurfing 'main'
	option enabled '0'
	# Logical netifd interface. Its current l3_device is resolved automatically.
	option interface 'wan'
	# Optional physical device override, e.g. eth0.2 or wan.
	# option device 'eth0.2'
	option credentials '/etc/esurfing/credentials'
	option retry_delay '5'
	option retry_max '300'
	# Reauthenticate without restarting WAN: off or daily.
	option reconnect_mode 'off'
	# Daily time uses the router's system timezone.
	option reconnect_time '04:00'
	# Independent Internet checks; three consecutive failures refresh the session.
	# Set to 0 to disable. Custom URLs must return empty 204 or Microsoft Connect Test.
	option check_interval '30'
	# option check_url 'http://www.msftconnecttest.com/connecttest.txt'
	# option gateway '192.0.2.1'
	# option portal_url 'http://preportal.go189.cn/detect.html'
