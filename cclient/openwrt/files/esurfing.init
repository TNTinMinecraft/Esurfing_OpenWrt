#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

extra_command "network_changed" "Refresh the active campus network session"

start_service() {
	local enabled interface device credentials gateway portal_url ticket_url auth_url retry_delay retry_max
	config_load esurfing
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get interface main interface wan
	config_get device main device
	config_get credentials main credentials /etc/esurfing/credentials
	config_get gateway main gateway
	config_get portal_url main portal_url
	config_get ticket_url main ticket_url
	config_get auth_url main auth_url
	config_get retry_delay main retry_delay 5
	config_get retry_max main retry_max 300

	if [ -z "$device" ]; then
		. /lib/functions/network.sh
		network_flush_cache
		network_get_device device "$interface" || {
			logger -t esurfing "Waiting for network interface $interface"
			return 0
		}
	fi
	# The executable validates ownership, permissions, bounds and URL pairing.
	procd_open_instance main
	procd_set_param command /usr/bin/esurfing --service --interface "$device" \
		--credentials "$credentials" --retry-delay "$retry_delay" --retry-max "$retry_max"
	[ -z "$gateway" ] || procd_append_param command --gateway "$gateway"
	[ -z "$portal_url" ] || procd_append_param command --portal-url "$portal_url"
	[ -z "$ticket_url" ] || procd_append_param command --ticket-url "$ticket_url"
	[ -z "$auth_url" ] || procd_append_param command --auth-url "$auth_url"
	procd_set_param file /etc/config/esurfing "$credentials"
	procd_set_param netdev "$device"
	# Network recovery happens inside C. Only unexpected process exits respawn;
	# permanent auth/protocol errors suspend inside --service until a restart.
	procd_set_param respawn 3600 30 3
	procd_set_param term_timeout 120
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_close_instance
}

service_triggers() {
	local interface
	config_load esurfing
	config_get interface main interface wan
	procd_add_reload_trigger esurfing
	procd_add_interface_trigger "interface.*" "$interface" /etc/init.d/esurfing network_changed
}

network_changed() {
	# Reload also picks up a replaced l3_device. Unchanged configuration keeps
	# the existing process, including any permanent-error suspension.
	# Signal before reload: a newly spawned process may not have installed its
	# handler yet, so never HUP a fresh process immediately after creating it.
	procd_send_signal esurfing main HUP 2>/dev/null || :
	reload
}
